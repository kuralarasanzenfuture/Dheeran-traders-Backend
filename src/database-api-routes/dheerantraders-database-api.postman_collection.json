    {
      "name": "2. Clear All Data (Truncate & Reset IDs)",
      "item": [
        {
          "name": "Clear All Chit Data (Wipe All & Reset Auto-Increment)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"All tables cleared\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.cleared_tables).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"confirm\": true,\n  \"preserve_masters\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/database-api/chit/clear-all-data",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "database-api",
                "chit",
                "clear-all-data"
              ]
            },
            "description": "Wipes all rows across all chit tables and resets AUTO_INCREMENT counters to 1. Preserves table structures."
          },
          "response": []
        },
        {
          "name": "Clear Transactional Data Only (Preserve Masters: Plans, Batches, Staff)",
          "event": [
            {
              "listen": "test",
              "script": {
