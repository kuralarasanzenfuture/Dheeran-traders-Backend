    {
      "name": "1. Status & Verification",
      "item": [
        {
          "name": "Get Chit Database Status & Table Record Counts",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has success true\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.tables).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/database-api/chit/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "database-api",
                "chit",
                "status"
              ]
            },
            "description": "Returns status, existence, and row count of all chit tables in MySQL."
          },
          "response": []
        },
